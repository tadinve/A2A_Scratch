# Copy to inventory_agent/.env and fill in. The real .env is git-ignored.

# Model name (any Gemini model available to your credentials)
GEMINI_MODEL=gemini-2.5-flash

# --- Option A: Gemini API key (AI Studio) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-here

# --- Option B: Vertex AI (uses gcloud application-default credentials) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Day 02: demo identity for the protected inventory lookup ---
# Generate the secret locally, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INVENTORY_PRINCIPAL=inventory_agent
INVENTORY_SHARED_SECRET=replace-with-a-generated-secret

# --- Calling the inventory service over HTTP ---
INVENTORY_SERVICE_URL=http://127.0.0.1:8000
# Day 05.3: the agent gets short-lived JWTs from the token issuer.
INVENTORY_ISSUER_URL=http://127.0.0.1:8001
INVENTORY_CLIENT_ID=inventory-agent
# Must match CLIENT_SECRET_INVENTORY_AGENT in token_issuer/.env
INVENTORY_CLIENT_SECRET=demo-local-secret
# Day 05.5: authority this agent requests for each token (space-delimited).
# Try class_b alone to watch WIDGET-A get 403 even though the role allows it.
INVENTORY_REQUESTED_SCOPE=inventory.read.class_b
