# Copy to token_issuer/.env.
# The signing key is chosen in config/issuer.json (override path with ISSUER_CONFIG).
# One secret per registered client; they must differ.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CLIENT_SECRET_INVENTORY_AGENT=replace-me
CLIENT_SECRET_RESTRICTED_AGENT=replace-me-too
