# Identity Service settings. Copy to identity_service/.env and fill in. The real .env is git-ignored.
# Google sign-in is the only login, so the GOOGLE_* client settings are required.

# Google Cloud Console > Google Auth Platform > Clients, type "Web application"
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret

# Register EXACTLY this as the client's authorized redirect URI. Use localhost, not 127.0.0.1.
GOOGLE_REDIRECT_URI=http://localhost:8002/auth/google/callback

# Fixed. Any other value stops the service.
GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Day 08: users, Google links and pending logins live in Firestore (Native mode).
# Credentials come from `gcloud auth application-default login`, never from this file.
IDENTITY_FIRESTORE_PROJECT=replace-with-gcp-project-id
IDENTITY_FIRESTORE_DATABASE=(default)
# To use the local emulator instead (gcloud emulators firestore start --host-port=localhost:8085):
# FIRESTORE_EMULATOR_HOST=localhost:8085
